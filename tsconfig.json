{
  "compilerOptions": {
    // Enable latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": false,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "paths": {
    "react-dom/server": ["react-dom/server.node"],
    "react-dom/server.bun": ["react-dom/server.node"],
  },
  "include": [
    // Not certain if this is a bug, but this is needed to silence global react
    // error. For some reason, the error persists if I also try to include ts
    // files.
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
